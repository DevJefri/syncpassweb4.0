# Variables de entorno para syncpassweb4.0 (configurar en Vercel: Settings → Environment Variables)
# Vite las hornea en build time → tras cambiarlas hay que hacer Redeploy.

# Supabase (REST) - https://<project-ref>.supabase.co
VITE_SUPABASE_URL=https://clxhnjoxszyzdhcjhxru.supabase.co
VITE_SUPABASE_ANON_KEY=<tu-anon-public-key-de-supabase>

# AWS Cognito (debe coincidir con el backend)
VITE_AWS_REGION=us-east-1
VITE_COGNITO_USER_POOL_ID=us-east-1_lLYEkDgbK
VITE_COGNITO_CLIENT_ID=5hd36m6qsssbl237dmalv18pv1
# Dominio de Cognito (Hosted UI). Formato: https://<prefix>.auth.<region>.amazoncognito.com
VITE_COGNITO_DOMAIN=https://us-east-1llyekdgbk.auth.us-east-1.amazoncognito.com

# Opcional: URL del backend (si el front llama a la API)
# VITE_API_URL=https://<tu-api-gateway>.execute-api.us-east-2.amazonaws.com/api